# Local development: copy this file to application.properties and fill in values.
# Cloud deployment: set the equivalent environment variables shown below each property.

# env: API_TOKEN
api.token=your_token_here
api.base.url=https://api.football-data.org/v4
# env: API_COMPETITION_CODES
api.competition.codes=PL,WC

# env: DB_URL
db.url=jdbc:postgresql://localhost:5432/standings
# env: DB_USER
db.user=your_db_username
# env: DB_PASSWORD
db.password=

# env: SCHEDULER_CRON
scheduler.cron=0 0 0/2 * * ?

server.port=8080
spring.jackson.serialization.write-dates-as-timestamps=false
